{"id":1031192,"xmlId":"tanvd.grazi","name":"Natural Languages","description":"<p>Intelligent spelling and grammar checks for any text you write in the IDE.</p>\n\n    <ul>\n      <li>\n        Supports over 20 languages, including English, German, Russian, and Chinese.\n        English is enabled by default.\n        To add other languages, open <b>Settings/Preferences | Editor | Natural Languages</b>.\n      </li>\n      <li>\n        Works with natural languages in programming language constructs (Python, Java, and others),\n        markup languages (Markdown, HTML, XML, and others), comments, and commit messages.\n      </li>\n      <li>Uses <a href=\"https://www.languagetool.org/\">LanguageTool</a> as its proofreading engine.</li>\n    </ul>\n\n    <p>Data privacy: all verification is performed locally, inside your IDE.</p>","organization":"JetBrains s.r.o.","tags":["Spellcheck"],"version":"253.32098.101","dependencies":["intellij.libraries.javax.activation","intellij.platform.vcs.impl","intellij.libraries.lucene.common","intellij.spellchecker","intellij.libraries.commons.text","intellij.libraries.grpc"],"optionalDependencies":["com.intellij.java","intellij.yaml.backend","intellij.properties.backend","intellij.json.backend","com.intellij.properties","intellij.properties.backend.psi","intellij.spellchecker.xml","org.intellij.plugins.markdown","com.intellij.modules.xml"],"since":"253.32098","until":"253.*","size":21471219,"vendor":"JetBrains","sourceCodeUrl":"https://github.com/JetBrains/intellij-community/tree/master/plugins/grazie","incompatibleWith":["com.intellij.jetbrains.client"],"mainModuleDependencies":[{"type":"module","moduleName":"intellij.libraries.lucene.common"},{"type":"module","moduleName":"intellij.spellchecker"},{"type":"module","moduleName":"intellij.platform.vcs.impl"},{"type":"module","moduleName":"intellij.libraries.grpc"},{"type":"module","moduleName":"intellij.libraries.commons.text"},{"type":"module","moduleName":"intellij.libraries.javax.